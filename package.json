{
  "name": "slidepig-workspace",
  "private": true,
  "packageManager": "pnpm@9.1.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter slidepig build && pnpm --filter slidepig-demo dev",
    "build": "pnpm -r --workspace-concurrency=1 build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "assets": "pnpm --filter slidepig-demo assets",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm format:check && pnpm typecheck && pnpm test && pnpm build && pnpm --filter slidepig size && pnpm --filter slidepig smoke"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "prettier": "^3.6.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  }
}
